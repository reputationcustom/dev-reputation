# Env local da Edge Function bw-sync (usado por `supabase functions serve`).
# Copie para supabase/functions/.env (gitignored) e preencha.
# Em produção, as mesmas três variáveis BRANDWATCH_* devem ser cadastradas
# como secrets da Edge Function (`supabase secrets set` ou Dashboard →
# Edge Functions → Secrets) — nunca no Next.js/frontend (Princípio técnico 1).

# Lidos pela função em produção.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Credenciais da conta Brandwatch usadas para mintar o access token em tempo
# de execução (grant_type=api-password) — ver
# .dev/specs/foundation/brandwatch-setup.md §1 e sync-brandwatch.md. Este
# MVP assume um único Client Brandwatch (por isso são secrets globais da
# função, não colunas por organização em brandwatch_credentials). O token
# resultante é cacheado em brandwatch_credentials.access_token_secret_ref
# (Vault) + token_expires_at — a função só chama /oauth/token de novo quando
# o cache expira.
BRANDWATCH_USERNAME=
BRANDWATCH_PASSWORD=
BRANDWATCH_PLATFORM_CLIENT_ID=1997437816
